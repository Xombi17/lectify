{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.3" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.0.0" }
  ],
  "title": "Lectify Overview",
  "tags": ["lectify", "monitoring"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "constant",
        "label": "Environment",
        "query": "production",
        "current": { "text": "production", "value": "production" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(http_requests_total[$__rate_interval])",
          "legendFormat": "{{method}} {{path}}",
          "interval": "15s"
        }
      ],
      "description": "Requests per second by endpoint"
    },
    {
      "title": "Request Latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p95",
          "interval": "30s"
        }
      ],
      "description": "95th percentile request latency"
    },
    {
      "title": "Error Rate (5xx)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(http_requests_total{status_code=~\"5..\"}[$__rate_interval])",
          "legendFormat": "5xx",
          "interval": "30s"
        }
      ],
      "description": "5xx error rate"
    },

    {
      "title": "Queue Depth",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "lectify_queue_depth",
          "legendFormat": "{{queue_type}}",
          "interval": "15s"
        }
      ],
      "description": "Queue depth by queue type"
    },
    {
      "title": "Processing Duration (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(lectify_queue_processing_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p95 {{queue_type}}",
          "interval": "30s"
        }
      ],
      "description": "P95 processing duration by queue type"
    },
    {
      "title": "Failure Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 1 }
          ]}
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(lectify_queue_failures_total[1h])",
          "legendFormat": "failures/h",
          "interval": "60s"
        }
      ],
      "description": "Failure rate by reason"
    },
    {
      "title": "DLQ Size",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "orange", "value": 5 },
            { "color": "red", "value": 10 }
          ]}
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "lectify_dead_letter_depth",
          "legendFormat": "{{queue_type}} DLQ",
          "interval": "30s"
        }
      ],
      "description": "Dead-letter queue size"
    },{
            "title": "Same-day SLA",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "Prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
            "fieldConfig": {
              "defaults": {
                "unit": "percent",
                "min": 0,
                "max": 100,
                "color": { "mode": "thresholds" },
                "thresholds": { "mode": "absolute", "steps": [
                  { "color": "red", "value": 0 },
                  { "color": "orange", "value": 80 },
                  { "color": "green", "value": 95 }
                ]}
              },
              "overrides": []
            },
            "targets": [
              {
                "expr": "lectify_sla_same_day_percent",
                "legendFormat": "SLA {{date_label}}",
                "interval": "60s"
              }
            ],
            "description": "Same-day processing SLA with target line"
          },
    {
      "title": "Lectures Processed (24h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 3, "x": 6, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(lectify_lectures_processed_total[24h])",
          "legendFormat": "processed/24h",
          "interval": "60s"
        }
      ],
      "description": "Daily lecture throughput"
    },
    {
      "title": "Processing Time Trend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 9, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(lectify_queue_processing_duration_seconds_sum[$__rate_interval]) / rate(lectify_queue_processing_duration_seconds_count[$__rate_interval])",
          "legendFormat": "avg {{queue_type}}",
          "interval": "60s"
        }
      ],
      "description": "Average processing time over time"
    },


    {
      "title": "AI Generation Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 3, "x": 6, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(lectify_ai_generation_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p95 {{task_type}}",
          "interval": "60s"
        }
      ],
      "description": "AI generation latency by task type"
    },
    {
      "title": "Token Consumption",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 3, "x": 9, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(lectify_ai_generation_tokens_total[5m])",
          "legendFormat": "{{model}} {{task_type}}",
          "interval": "30s"
        }
      ],
      "description": "Token consumption rate by model"
    }
  ],
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "enable": true,
        "expr": "resets(lectify_active_lectures[5m]) > 0",
        "name": "Worker Restart",
        "iconColor": "orange"
      }
    ]
  },
  "links": [],
  "editable": true
}
