[Unit]
Description=Lectify Worker Service
After=network.target

[Service]
Type=simple
User=lectify
Group=lectify
WorkingDirectory=/opt/lectify/backend
EnvironmentFile=/etc/lectify/app.env
ExecStart=/opt/lectify/venv/bin/python -m workers all
StandardOutput=append:/var/log/lectify/worker.log
StandardError=append:/var/log/lectify/worker.log
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120
MemoryMax=1200M
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
