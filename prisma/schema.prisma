generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users ──────────────────────────────────────────────────────────────────────
model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  role         String
  passwordHash String           @map("password_hash")
  createdAt    DateTime         @default(now()) @map("created_at")
  lectures     Lecture[]
  chatMessages ChatMessage[]
  quizAttempts QuizAttempt[]
  bookmarks    Bookmark[]
  flashcardReviews FlashcardReview[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetableSlots     TimetableSlot[]

  @@index([email])
  @@map("users")
}

// ── Lectures ───────────────────────────────────────────────────────────────────
model Lecture {
  id                      String           @id @default(cuid())
  teacherId               String           @map("teacher_id")
  title                   String
  subject                 String?
  semester                String?
  audioObjectKey          String           @map("audio_object_key")
  audioFilename           String           @map("audio_filename")
  audioMime               String           @map("audio_mime")
  durationSeconds         Float?           @map("duration_seconds")
  chunkCount              Int?             @map("chunk_count")
  progressStep            Int              @default(0) @map("progress_step")
  progressTotal           Int              @default(0) @map("progress_total")
  progressLabel           String?          @map("progress_label")
  status                  String           @default("uploaded")
  transcript              String?
  transcriptionConfidence Float?           @map("transcription_confidence")
  transcriptionLanguage   String?          @map("transcription_language")
  transcriptionCostUsd    Float?           @map("transcription_cost_usd")
  lowConfidenceSegments   Json?            @map("low_confidence_segments")
  materials               Json             @default("{}")
  embedding               Json?            // list of floats stored as JSON
  translations            Json             @default("{}")
  cheatsheet              Json?
  podcastScript           Json?            @map("podcast_script")
  quizV2                  Json?            @map("quiz_v2")
  conceptsV2              Json?            @map("concepts_v2")
  errorMessage            String?          @map("error_message")
  published               Boolean          @default(false)
  classId                 String?          @map("class_id")
  timetableSlotId         String?          @map("timetable_slot_id")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @default(now()) @map("updated_at")

  teacher                 User             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class                   Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  timetableSlot           TimetableSlot?   @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  chatMessages            ChatMessage[]
  quizAttempts            QuizAttempt[]
  bookmarks               Bookmark[]
  flashcardReviews        FlashcardReview[]

  @@index([teacherId])
  @@index([status])
  @@index([published])
  @@index([classId])
  @@index([timetableSlotId])
  @@map("lectures")
}

// ── Chat Messages ──────────────────────────────────────────────────────────────
model ChatMessage {
  id        String   @id @default(cuid())
  lectureId String   @map("lecture_id")
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([userId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ── Quiz Attempts ──────────────────────────────────────────────────────────────
model QuizAttempt {
  id         String   @id @default(cuid())
  lectureId  String   @map("lecture_id")
  userId     String   @map("user_id")
  score      Int
  total      Int
  percentage Float
  createdAt  DateTime @default(now()) @map("created_at")

  lecture    Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([userId])
  @@index([createdAt])
  @@map("quiz_attempts")
}

// ── Bookmarks ──────────────────────────────────────────────────────────────────
model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  lectureId String   @map("lecture_id")
  kind      String
  text      String
  refIndex  Int?     @map("ref_index")
  createdAt DateTime @default(now()) @map("created_at")

  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lectureId])
  @@index([createdAt])
  @@map("bookmarks")
}

// ── Flashcard Reviews ──────────────────────────────────────────────────────────
model FlashcardReview {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  lectureId      String    @map("lecture_id")
  cardIndex      Int       @map("card_index")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  intervalDays   Int       @default(0) @map("interval_days")
  repetitions    Int       @default(0)
  lastReviewedAt DateTime? @map("last_reviewed_at")
  dueAt          DateTime  @default(now()) @map("due_at")
  totalReviews   Int       @default(0) @map("total_reviews")

  lecture        Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lectureId])
  @@index([dueAt])
  @@map("flashcard_reviews")
}

// ── Academic Hierarchy ─────────────────────────────────────────────────────────
model Institution {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  address   String?
  createdAt DateTime  @default(now()) @map("created_at")
  years     Year[]
  branches  Branch[]
  batches   Batch[]

  @@index([code])
  @@map("institutions")
}

model Year {
  id            String     @id @default(cuid())
  institutionId String     @map("institution_id")
  number        Int
  name          String
  createdAt     DateTime   @default(now()) @map("created_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semesters     Semester[]

  @@index([institutionId])
  @@unique([institutionId, number])
  @@map("years")
}

model Branch {
  id            String     @id @default(cuid())
  institutionId String     @map("institution_id")
  code          String
  name          String
  createdAt     DateTime   @default(now()) @map("created_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  divisions     Division[]
  subjects      Subject[]

  @@index([institutionId])
  @@unique([institutionId, code])
  @@map("branches")
}

model Semester {
  id        String     @id @default(cuid())
  yearId    String     @map("year_id")
  number    Int
  label     String
  createdAt DateTime   @default(now()) @map("created_at")
  year      Year       @relation(fields: [yearId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  divisions Division[]
  batchSemesters BatchSemester[]

  @@index([yearId])
  @@unique([yearId, number])
  @@map("semesters")
}

model Subject {
  id         String     @id @default(cuid())
  semesterId String     @map("semester_id")
  branchId   String?    @map("branch_id")
  code       String
  name       String
  credits    Int?
  category   String?
  createdAt  DateTime   @default(now()) @map("created_at")
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classes    Class[]

  @@index([semesterId])
  @@index([branchId])
  @@unique([semesterId, branchId, code])
  @@map("subjects")
}

model Division {
  id         String     @id @default(cuid())
  semesterId String?    @map("semester_id")
  branchId   String?    @map("branch_id")
  batchId    String?    @map("batch_id")
  name       String
  capacity   Int?
  createdAt  DateTime   @default(now()) @map("created_at")
  semester   Semester?  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  batch      Batch?     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  classes    Class[]

  @@index([semesterId])
  @@index([branchId])
  @@index([batchId])
  @@unique([semesterId, name])
  @@map("divisions")
}

model Batch {
  id             String      @id @default(cuid())
  institutionId  String      @map("institution_id")
  admissionYear  Int         @map("admission_year")
  graduatingYear Int         @map("graduating_year")
  name           String
  createdAt      DateTime    @default(now()) @map("created_at")
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  divisions      Division[]
  batchSemesters BatchSemester[]

  @@index([institutionId])
  @@unique([institutionId, graduatingYear])
  @@map("batches")
}

model BatchSemester {
  id           String   @id @default(cuid())
  batchId      String   @map("batch_id")
  semesterId   String   @map("semester_id")
  academicYear String   @map("academic_year")
  startsOn     DateTime @map("starts_on")
  endsOn       DateTime @map("ends_on")
  createdAt    DateTime @default(now()) @map("created_at")
  batch        Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  semester     Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  classes      Class[]

  @@index([batchId])
  @@index([semesterId])
  @@unique([batchId, semesterId])
  @@map("batch_semesters")
}

model Class {
  id               String                @id @default(cuid())
  divisionId       String                @map("division_id")
  subjectId        String                @map("subject_id")
  batchSemesterId  String?               @map("batch_semester_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  division         Division              @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  subject          Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  batchSemester    BatchSemester?        @relation(fields: [batchSemesterId], references: [id], onDelete: SetNull)
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  lectures     Lecture[]
  timetableSlots TimetableSlot[]

  @@index([divisionId])
  @@index([subjectId])
  @@index([batchSemesterId])
  @@unique([divisionId, subjectId, batchSemesterId])
  @@map("classes")
}

model TeacherAssignment {
  id         String   @id @default(cuid())
  classId    String   @map("class_id")
  teacherId  String   @map("teacher_id")
  active     Boolean  @default(true)
  assignedAt DateTime @default(now()) @map("assigned_at")
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([teacherId])
  @@unique([classId, teacherId])
  @@map("teacher_assignments")
}

model StudentEnrollment {
  id         String   @id @default(cuid())
  classId    String   @map("class_id")
  studentId  String   @map("student_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([studentId])
  @@unique([classId, studentId])
  @@map("student_enrollments")
}

// ── Timetable Slots ───────────────────────────────────────────────────────────
model TimetableSlot {
  id         String   @id @default(cuid())
  classId    String   @map("class_id")
  teacherId  String   @map("teacher_id")
  dayOfWeek  Int      @map("day_of_week")
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  room       String?
  createdAt  DateTime @default(now()) @map("created_at")

  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lectures   Lecture[]

  @@index([classId])
  @@index([teacherId])
  @@map("timetable_slots")
}

// ── Jobs ───────────────────────────────────────────────────────────────────────
model Job {
  id            String   @id @default(cuid())
  lectureId     String   @map("lecture_id")
  stage         String
  version       Int      @default(1)
  status        String
  attempt       Int      @default(0)
  maxAttempts   Int      @default(5) @map("max_attempts")
  priorityScore Float    @default(0.0) @map("priority_score")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@index([status])
  @@unique([lectureId, stage, version])
  @@map("jobs")
}

model JobChunk {
  id            String   @id @default(cuid())
  lectureId     String   @map("lecture_id")
  version       Int      @default(1)
  chunkIndex    Int      @map("chunk_index")
  status        String   @default("pending")
  text          String?
  error         String?
  attempts      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@unique([lectureId, version, chunkIndex])
  @@map("job_chunks")
}
