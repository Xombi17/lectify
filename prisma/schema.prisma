generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users ──────────────────────────────────────────────────────────────────────
model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  role         String
  passwordHash String           @map("password_hash")
  createdAt    DateTime         @default(now()) @map("created_at")
  lectures     Lecture[]
  chatMessages ChatMessage[]
  quizAttempts QuizAttempt[]
  bookmarks    Bookmark[]
  flashcardReviews FlashcardReview[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]

  @@index([email])
  @@map("users")
}

// ── Lectures ───────────────────────────────────────────────────────────────────
model Lecture {
  id              String           @id @default(cuid())
  teacherId       String           @map("teacher_id")
  title           String
  subject         String?
  semester        String?
  audioObjectKey  String           @map("audio_object_key")
  audioFilename   String           @map("audio_filename")
  audioMime       String           @map("audio_mime")
  durationSeconds Float?           @map("duration_seconds")
  chunkCount      Int?             @map("chunk_count")
  progressStep    Int              @default(0) @map("progress_step")
  progressTotal   Int              @default(0) @map("progress_total")
  progressLabel   String?          @map("progress_label")
  status          String           @default("uploaded")
  transcript      String?
  materials       Json             @default("{}")
  embedding       Json?            // list of floats stored as JSON
  translations    Json             @default("{}")
  errorMessage    String?          @map("error_message")
  published       Boolean          @default(false)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @map("updated_at")

  teacher         User             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  chatMessages    ChatMessage[]
  quizAttempts    QuizAttempt[]
  bookmarks       Bookmark[]
  flashcardReviews FlashcardReview[]

  @@index([teacherId])
  @@index([status])
  @@index([published])
  @@map("lectures")
}

// ── Chat Messages ──────────────────────────────────────────────────────────────
model ChatMessage {
  id        String   @id @default(cuid())
  lectureId String   @map("lecture_id")
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([userId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ── Quiz Attempts ──────────────────────────────────────────────────────────────
model QuizAttempt {
  id         String   @id @default(cuid())
  lectureId  String   @map("lecture_id")
  userId     String   @map("user_id")
  score      Int
  total      Int
  percentage Float
  createdAt  DateTime @default(now()) @map("created_at")

  lecture    Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([userId])
  @@index([createdAt])
  @@map("quiz_attempts")
}

// ── Bookmarks ──────────────────────────────────────────────────────────────────
model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  lectureId String   @map("lecture_id")
  kind      String
  text      String
  refIndex  Int?     @map("ref_index")
  createdAt DateTime @default(now()) @map("created_at")

  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lectureId])
  @@index([createdAt])
  @@map("bookmarks")
}

// ── Flashcard Reviews ──────────────────────────────────────────────────────────
model FlashcardReview {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  lectureId      String    @map("lecture_id")
  cardIndex      Int       @map("card_index")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  intervalDays   Int       @default(0) @map("interval_days")
  repetitions    Int       @default(0)
  lastReviewedAt DateTime? @map("last_reviewed_at")
  dueAt          DateTime  @default(now()) @map("due_at")
  totalReviews   Int       @default(0) @map("total_reviews")

  lecture        Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lectureId])
  @@index([dueAt])
  @@map("flashcard_reviews")
}

// ── Academic Hierarchy ─────────────────────────────────────────────────────────
model Institution {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  address   String?
  createdAt DateTime  @default(now()) @map("created_at")
  years     Year[]
  branches  Branch[]

  @@index([code])
  @@map("institutions")
}

model Year {
  id            String     @id @default(cuid())
  institutionId String     @map("institution_id")
  number        Int
  name          String
  createdAt     DateTime   @default(now()) @map("created_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semesters     Semester[]

  @@index([institutionId])
  @@unique([institutionId, number])
  @@map("years")
}

model Branch {
  id            String     @id @default(cuid())
  institutionId String     @map("institution_id")
  code          String
  name          String
  createdAt     DateTime   @default(now()) @map("created_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@unique([institutionId, code])
  @@map("branches")
}

model Semester {
  id        String     @id @default(cuid())
  yearId    String     @map("year_id")
  number    Int
  label     String
  createdAt DateTime   @default(now()) @map("created_at")
  year      Year       @relation(fields: [yearId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  divisions Division[]

  @@index([yearId])
  @@unique([yearId, number])
  @@map("semesters")
}

model Subject {
  id         String     @id @default(cuid())
  semesterId String     @map("semester_id")
  code       String
  name       String
  credits    Int?
  createdAt  DateTime   @default(now()) @map("created_at")
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  classes    Class[]

  @@index([semesterId])
  @@unique([semesterId, code])
  @@map("subjects")
}

model Division {
  id         String     @id @default(cuid())
  semesterId String     @map("semester_id")
  name       String
  capacity   Int?
  createdAt  DateTime   @default(now()) @map("created_at")
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  classes    Class[]

  @@index([semesterId])
  @@unique([semesterId, name])
  @@map("divisions")
}

model Class {
  id           String                @id @default(cuid())
  divisionId   String                @map("division_id")
  subjectId    String                @map("subject_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  division     Division              @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  subject      Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]

  @@index([divisionId])
  @@index([subjectId])
  @@unique([divisionId, subjectId])
  @@map("classes")
}

model TeacherAssignment {
  id         String   @id @default(cuid())
  classId    String   @map("class_id")
  teacherId  String   @map("teacher_id")
  active     Boolean  @default(true)
  assignedAt DateTime @default(now()) @map("assigned_at")
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([teacherId])
  @@unique([classId, teacherId])
  @@map("teacher_assignments")
}

model StudentEnrollment {
  id         String   @id @default(cuid())
  classId    String   @map("class_id")
  studentId  String   @map("student_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([studentId])
  @@unique([classId, studentId])
  @@map("student_enrollments")
}
